// Pipeline declarativo del prototipo. Cada etapa llama a ci/run-pipeline.sh: lo que corre en Jenkins es exactamente
// lo que corre en local. Los gates detienen el pipeline: secretos, dependencias, huellas de la normativa, banco de
// defectos, mapeo vigente y escaneo de vulnerabilidades.
pipeline {
  agent any
  options {
    timestamps()
    timeout(time: 45, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
    disableConcurrentBuilds()
  }
  parameters {
    choice(name: 'TARGET_ENV', choices: ['sit', 'uat', 'prod'], description: 'Ambiente destino del despliegue')
    string(name: 'MIN_RUNTIME_DETECTION', defaultValue: '0.80', description: 'Umbral del gate de detección en ejecución')
  }
  environment {
    REGISTRY = credentials('registry-url')      // URL del registro de imágenes (credencial de tipo texto)
    MIN_RUNTIME_DETECTION = "${params.MIN_RUNTIME_DETECTION}"
    PYTHON = "${WORKSPACE}/prototipo/agentic-plane/.venv/bin/python"
  }
  stages {
    stage('Entorno') {
      steps {
        dir('prototipo/agentic-plane') {
          sh 'python3.12 -m venv .venv && .venv/bin/pip install -q -e ".[test]" packaging'
        }
      }
    }
    stage('Compilar') { steps { dir('prototipo') { sh 'ci/run-pipeline.sh build' } } }
    stage('Gates previos') {
      parallel {
        stage('Gate · secretos') { steps { dir('prototipo') { sh 'ci/run-pipeline.sh gate-secrets' } } }
        stage('Gate · huellas de normativa') { steps { dir('prototipo') { sh 'ci/run-pipeline.sh gate-normative' } } }
        stage('Gate · dependencias') { steps { dir('prototipo') { sh 'ci/run-pipeline.sh gate-deps' } } }
      }
    }
    stage('Pruebas') {
      parallel {
        stage('Java · JUnit 5') { steps { dir('prototipo') { sh 'ci/run-pipeline.sh test-java' } } }
        stage('Python · pytest') { steps { dir('prototipo') { sh 'ci/run-pipeline.sh test-python' } } }
      }
      post { always { junit allowEmptyResults: false, testResults: 'prototipo/build-reports/junit-java/*.xml, prototipo/build-reports/junit-python.xml' } }
    }
    stage('Gate · banco de defectos') {
      steps { dir('prototipo') { sh 'ci/run-pipeline.sh gate-bank' } }
      post { always { archiveArtifacts artifacts: 'prototipo/build-reports/defect-bank/*', fingerprint: true } }
    }
    stage('Gate · mapeo vigente') { steps { dir('prototipo') { sh 'ci/run-pipeline.sh gate-mapping' } } }
    stage('Gate · vulnerabilidades y configuración') {
      steps { dir('prototipo') { sh 'trivy fs --exit-code 1 --severity HIGH,CRITICAL --scanners vuln,secret,misconfig .' } }
    }
    stage('Empaquetar y humo') {
      steps {
        dir('prototipo') { sh 'ci/run-pipeline.sh package smoke' }
        archiveArtifacts artifacts: 'prototipo/dist/*', fingerprint: true
      }
    }
    stage('Imágenes') {
      steps {
        dir('prototipo') {
          sh '''
            docker build -f deploy/docker/platform.Dockerfile -t $REGISTRY/veriagent/platform:$BUILD_NUMBER .
            docker build -f deploy/docker/agentic.Dockerfile -t $REGISTRY/veriagent/agentic-plane:$BUILD_NUMBER .
            trivy image --exit-code 1 --severity CRITICAL $REGISTRY/veriagent/platform:$BUILD_NUMBER
            trivy image --exit-code 1 --severity CRITICAL $REGISTRY/veriagent/agentic-plane:$BUILD_NUMBER
            docker push $REGISTRY/veriagent/platform:$BUILD_NUMBER
            docker push $REGISTRY/veriagent/agentic-plane:$BUILD_NUMBER
          '''
        }
      }
    }
    stage('Desplegar SIT') {
      steps {
        dir('prototipo') {
          sh '''helm upgrade --install veriagent deploy/helm/tfg-poc -n veriagent-sit --create-namespace \
                -f deploy/helm/tfg-poc/values.yaml --set image.registry=$REGISTRY --set image.tag=$BUILD_NUMBER --wait'''
          sh 'kubectl -n veriagent-sit run smoke-$BUILD_NUMBER --rm -i --restart=Never --image=curlimages/curl -- -sf http://veriagent-platform:8080/actuator/health'
        }
      }
    }
    stage('Aprobación para UAT/PROD') {
      when { expression { params.TARGET_ENV != 'sit' } }
      steps { input message: "¿Promover el build ${env.BUILD_NUMBER} a ${params.TARGET_ENV}?", submitter: 'lider-tecnico,gerente-proyecto' }
    }
    stage('Desplegar UAT/PROD') {
      when { expression { params.TARGET_ENV != 'sit' } }
      steps {
        dir('prototipo') {
          sh '''helm upgrade --install veriagent deploy/helm/tfg-poc -n veriagent-$TARGET_ENV --create-namespace \
                -f deploy/helm/tfg-poc/values-$TARGET_ENV.yaml --set image.registry=$REGISTRY --set image.tag=$BUILD_NUMBER --wait --atomic'''
        }
      }
    }
  }
  post {
    failure { echo 'Pipeline detenido: revisa el gate que falló en los reportes archivados.' }
  }
}
