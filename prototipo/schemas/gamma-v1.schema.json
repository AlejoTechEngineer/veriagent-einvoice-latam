{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:veriagent:schemas:gamma:v1",
  "title": "Documento del proveedor Gamma v1 (estructura)",
  "description": "Validación estructural del formato JSON de Gamma (equivalente al XSD del perfil Alfa). Las reglas de negocio están en el verificador.",
  "type": "object",
  "required": ["header", "parties", "lines", "totals"],
  "additionalProperties": false,
  "properties": {
    "header": {
      "type": "object",
      "required": ["specVersion", "number", "issueDate", "documentType", "currency"],
      "additionalProperties": false,
      "properties": {
        "specVersion": { "type": "string" },
        "number": { "type": "string" },
        "issueDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "documentType": { "type": "string" },
        "currency": { "type": "string" },
        "originalNumber": { "type": "string" }
      }
    },
    "parties": {
      "type": "object",
      "required": ["seller", "buyer"],
      "additionalProperties": false,
      "properties": {
        "seller": { "$ref": "#/$defs/party" },
        "buyer": { "$ref": "#/$defs/party" }
      }
    },
    "lines": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["lineNo", "description", "qty", "unitPrice", "net", "taxCode", "taxRate"],
        "additionalProperties": false,
        "properties": {
          "lineNo": { "type": "integer" },
          "description": { "type": "string" },
          "qty": { "type": "string" },
          "unitPrice": { "type": "string" },
          "net": { "type": "string" },
          "taxCode": { "type": "string" },
          "taxRate": { "type": "string" }
        }
      }
    },
    "totals": {
      "type": "object",
      "required": ["net", "tax", "gross"],
      "additionalProperties": false,
      "properties": {
        "net": { "type": "string" },
        "tax": { "type": "string" },
        "gross": { "type": "string" }
      }
    }
  },
  "$defs": {
    "party": {
      "type": "object",
      "required": ["name", "taxId", "idScheme"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "taxId": { "type": "string" },
        "idScheme": { "type": "string" },
        "email": { "type": "string" }
      }
    }
  }
}
