<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>org.veriagent</groupId>
  <artifactId>integration-plane</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>integration-plane</name>
  <description>Plano de integración del prototipo: contratos, núcleo, servicios y aplicación Boot</description>

  <modules>
    <module>../verification-kit</module>
    <module>platform-contracts</module>
    <module>platform-core</module>
    <module>kit-adapter</module>
    <module>provider-common</module>
    <module>svc-invoice-router</module>
    <module>svc-ingest-sftp</module>
    <module>svc-provider-adapter</module>
    <module>svc-provider-connector</module>
    <module>svc-invoice-facade</module>
    <module>svc-response-processor</module>
    <module>svc-response-publisher</module>
    <module>svc-legal-archive</module>
    <module>svc-invoice-registry</module>
    <module>svc-dlq-handler</module>
    <module>platform-app</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <camel.version>4.23.0</camel.version>
    <springdoc.version>3.1.1</springdoc.version>
    <json-schema-validator.version>3.0.8</json-schema-validator.version>
    <resilience4j.version>2.4.0</resilience4j.version>
    <verification-kit.version>0.2.0</verification-kit.version>
    <!-- Raíz del prototipo: specs/, catalogs/ y schemas/ del kit -->
    <veriagent.home>${maven.multiModuleProjectDirectory}/..</veriagent.home>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.apache.camel.springboot</groupId>
        <artifactId>camel-spring-boot-bom</artifactId>
        <version>${camel.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${json-schema-validator.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-retry</artifactId>
        <version>${resilience4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.veriagent</groupId>
        <artifactId>verification-kit</artifactId>
        <version>${verification-kit.version}</version>
      </dependency>
      <dependency>
        <groupId>org.veriagent</groupId>
        <artifactId>platform-contracts</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.veriagent</groupId>
        <artifactId>platform-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.veriagent</groupId>
        <artifactId>platform-core</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.veriagent</groupId>
        <artifactId>kit-adapter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.veriagent</groupId>
        <artifactId>provider-common</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <parameters>true</parameters>
            <compilerArgs>
              <arg>-Xlint:all,-processing,-serial</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <includes>
              <include>**/*Test.java</include>
              <include>**/*IT.java</include>
            </includes>
            <systemPropertyVariables>
              <veriagent.home>${veriagent.home}</veriagent.home>
            </systemPropertyVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
